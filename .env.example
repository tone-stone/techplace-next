# Copy this file to .env.local and fill in real values for local dev.
# These same names go into GitHub → Settings → Secrets and variables →
# Actions, so the CI workflow's build step can run (see .github/workflows/ci.yml).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name

# Meta (Facebook Page + linked Instagram Business account) — powers the
# "Síguenos en redes" section on the homepage. Optional: without these, the
# section just doesn't render. See developers.facebook.com/tools/explorer to
# generate a long-lived Page Access Token with pages_read_engagement,
# pages_show_list, instagram_basic and business_management permissions.
META_PAGE_ID=your-facebook-page-id
META_PAGE_ACCESS_TOKEN=your-long-lived-page-access-token
META_IG_BUSINESS_ID=your-instagram-business-account-id

# Cobranza + agenda: correo transaccional (recordatorios + resúmenes internos) y
# los crons diarios en /api/cron/cobranza y /api/cron/agenda. Sin RESEND_API_KEY
# el envío se omite y solo se loguea (útil en local/CI). CRON_SECRET protege las
# rutas de cron: Vercel Cron manda "Authorization: Bearer $CRON_SECRET".
# BILLING_FROM_EMAIL es el remitente por defecto si app_settings.billing_from_email
# está vacío.
RESEND_API_KEY=
CRON_SECRET=
BILLING_FROM_EMAIL=

# WhatsApp (Twilio) — canal opcional para recordatorios de cobro, avisos de
# cotización y la agenda diaria. Se activa además con el switch de Configuración
# (app_settings.notify_whatsapp_enabled). Sin estas tres, el envío por WhatsApp
# se omite (se loguea) aunque el switch esté encendido.
#   TWILIO_ACCOUNT_SID    empieza con "AC…"
#   TWILIO_WHATSAPP_FROM  el remitente, p.ej. "whatsapp:+14155238886"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# PageSpeed Insights card on the admin monitoring dashboard. Both optional:
# the PSI API works keyless (rate-limited to ~1 req/s per IP, which the
# 6h server-side cache stays well under). Set PAGESPEED_API_KEY (create one
# in Google Cloud Console → PageSpeed Insights API) to raise that limit.
# PAGESPEED_TARGET_URL overrides which URL is analysed; defaults to
# https://techplacetj.com.
PAGESPEED_API_KEY=
PAGESPEED_TARGET_URL=
